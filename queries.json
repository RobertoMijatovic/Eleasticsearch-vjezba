//Match query pretraga knjiga po opisu koji imaju pojam roman
GET /knjige/_search
{
  "query": {
    "match": {
      "opis": "roman"
    }
  }
}

//Match query pretraga knjiga koje su povezane sa pojmovima pravda i sudbina
GET /knjige/_search
{
  "query": {
    "match": {
      "opis": "pravda sudbina"
    }
  }
}

/* BOOl query sa upitom(Sastavite jedan upit koji vraća sve knjige koje istovremeno:
13.	su dostupne (dostupno = true)
14.	koštaju manje ili jednako 22 KM
15.	u opisu imaju riječ roman
16.	rezultate dodatno sortirajte po cijeni uzlazno (sort: [{ "cijena": "asc" }])
)*/
GET /knjige/_search
{
  "query": {
    "bool": {
      "must": [
        { "match": { "opis": "roman" } }
      ],
      "filter": [
        { "term": { "dostupno": true } },
        { "range": { "cijena": { "lte": 22 } } }
      ]
    }
  },
  "sort": [
    { "cijena": "asc" }
  ]
}


//Hrvatski analyzer
POST /knjige/_analyze
{
  "analyzer": "hrvatski_analyzer",
  "text": "Na Drini ćuprija"
}

//4 upita sa agregacijama
//1.broj knjiga po autoru
GET /knjige/_search
{
  "size": 0,
  "aggs": {
    "po_autoru": {
      "terms": { "field": "autor" }
    }
  }
}
//2.prosječna cijena po žanru
GET /knjige/_search
{
  "size": 0,
  "aggs": {
    "po_zanru": {
      "terms": { "field": "zanr" },
      "aggs": {
        "avg_cijena": {
          "avg": { "field": "cijena" }
        }
      }
    }
  }
}
//3.najskuplja knjiga po žanru
GET /knjige/_search
{
  "size": 0,
  "aggs": {
    "po_zanru": {
      "terms": { "field": "zanr" },
      "aggs": {
        "max_cijena": {
          "max": { "field": "cijena" }
        }
      }
    }
  }
}

//4.po broju dostupinih i nedostupnih knjiga
GET /knjige/_search
{
  "size": 0,
  "aggs": {
    "dostupnost": {
      "terms": { "field": "dostupno" }
    }
  }
}