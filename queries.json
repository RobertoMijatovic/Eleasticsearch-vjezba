//3.Match query
GET /filmovi/_search
{
  "query": {
    "match": {
      "opis": "svemir"
    }
  }
}

//4.Term query
GET /filmovi/_search
{
  "query": {
    "term": {
      "redatelj": "Christopher Nolan"
    }
  }
}

//5.Range query
GET /filmovi/_search
{
  "query": {
    "range": {
      "ocjena": {
        "gt": 8
      }
    }
  }
}

//6.Bool query
GET /filmovi/_search
{
  "query": {
    "bool": {
      "must": [
        { "match": { "opis": "film" } }
      ],
      "filter": [
        { "term": { "dostupno": true } },
        { "range": { "ocjena": { "gte": 7 } } }
      ]
    }
  }
}

//7.Agregacija
GET /filmovi/_search
{
  "size": 0,
  "aggs": {
    "po_zanru": {
      "terms": { "field": "zanr" },
      "aggs": {
        "avg_ocjena": {
          "avg": { "field": "ocjena" }
        }
      }
    }
  }
}